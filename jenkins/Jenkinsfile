pipeline {
    agent any
    
    environment {
        VAULT_ADDR = 'http://vault.vault.svc.cluster.local:8200'
        NAMESPACE = 'demo-app'
        KUBECTL_PATH = "${WORKSPACE}/kubectl"
        JQ_PATH = "${WORKSPACE}/jq"
        // El token de Vault se obtiene desde credenciales en el stage correspondiente
    }
    
    stages {
        stage('Preparar entorno') {
            steps {
                script {
                    sh '''
                        # Instalar kubectl si no está disponible
                        if ! command -v kubectl &> /dev/null && [ ! -f "${KUBECTL_PATH}" ]; then
                            echo "Instalando kubectl..."
                            curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                            chmod +x kubectl
                            mv kubectl ${KUBECTL_PATH}
                        fi
                        
                        # Instalar jq si no está disponible
                        if ! command -v jq &> /dev/null && [ ! -f "${JQ_PATH}" ]; then
                            echo "Instalando jq..."
                            curl -L -o ${JQ_PATH} https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-linux-amd64
                            chmod +x ${JQ_PATH}
                        fi
                        
                        # Crear alias o usar directamente
                        export KUBECTL_CMD=$(command -v kubectl || echo "${KUBECTL_PATH}")
                        export JQ_CMD=$(command -v jq || echo "${JQ_PATH}")
                        
                        # Verificar que estamos en Kubernetes
                        echo "Verificando acceso a Kubernetes..."
                        ${KUBECTL_CMD} cluster-info || echo "Kubectl no disponible, pero continuando..."
                        
                        # Verificar conexión con Vault usando curl
                        echo "Verificando acceso a Vault..."
                        curl -s ${VAULT_ADDR}/v1/sys/health || echo "Vault no está disponible todavía"
                    '''
                }
            }
        }
        
        stage('Obtener secretos de Vault') {
            steps {
                withCredentials([string(credentialsId: 'vault-jenkins-token', variable: 'VAULT_TOKEN')]) {
                    script {
                        echo 'Conectando a Vault y obteniendo secretos...'
                        sh '''
                            # Verificar que el token está disponible
                            if [ -z "${VAULT_TOKEN}" ]; then
                                echo "ERROR: VAULT_TOKEN no configurado"
                                echo "Por favor configura la credencial 'vault-jenkins-token' en Jenkins:"
                                echo "  Jenkins > Manage Jenkins > Credentials > Add > Secret text"
                                echo "  ID: vault-jenkins-token"
                                echo "  Secret: [tu token de Vault]"
                                exit 1
                            fi
                        
                        # Usar script auxiliar o ejecutar directamente
                        if [ -f "jenkins/scripts/get-vault-secrets.sh" ]; then
                            bash jenkins/scripts/get-vault-secrets.sh
                        else
                            # Método directo usando curl
                            echo "Obteniendo secretos de secret/data/demo-app usando curl..."
                            
                            SECRETS_JSON=$(curl -s \
                                -H "X-Vault-Token: ${VAULT_TOKEN}" \
                                ${VAULT_ADDR}/v1/secret/data/demo-app)
                            
                            JQ_CMD=$(command -v jq || echo "${JQ_PATH}")
                            if echo "$SECRETS_JSON" | ${JQ_CMD} -e '.data.data' > /dev/null 2>&1; then
                                echo "$SECRETS_JSON" | ${JQ_CMD} -r '.data.data | to_entries[] | (.key + "=" + .value)' > /tmp/secrets.env
                                echo "Secretos obtenidos: $(wc -l < /tmp/secrets.env) variables"
                            else
                                echo "ERROR: No se pudieron obtener secretos"
                                echo "Respuesta: $SECRETS_JSON"
                                exit 1
                            fi
                        else
                            echo "ERROR: No se encontró el script auxiliar ni se pudo obtener secretos directamente"
                            exit 1
                        fi
                        '''
                    }
                }
            }
        }
        
        stage('Crear Secret de Kubernetes') {
            steps {
                script {
                    echo 'Creando Secret de Kubernetes desde los secretos de Vault...'
                    sh '''
                        KUBECTL_CMD=$(command -v kubectl || echo "${KUBECTL_PATH}")
                        # Crear el namespace si no existe
                        ${KUBECTL_CMD} create namespace ${NAMESPACE} --dry-run=client -o yaml | ${KUBECTL_CMD} apply -f -
                        
                        # Crear el Secret desde los valores obtenidos de Vault
                        # Leer los secretos y crear un Secret de Kubernetes
                        ${KUBECTL_CMD} create secret generic demo-app-secret \
                            --from-env-file=/tmp/secrets.env \
                            --namespace=${NAMESPACE} \
                            --dry-run=client -o yaml | ${KUBECTL_CMD} apply -f -
                        
                        echo "Secret 'demo-app-secret' creado/actualizado en el namespace ${NAMESPACE}"
                        ${KUBECTL_CMD} get secret demo-app-secret -n ${NAMESPACE}
                    '''
                }
            }
        }
        
        stage('Desplegar manifiestos') {
            steps {
                script {
                    echo 'Desplegando manifiestos de Kubernetes...'
                    dir('demo-app') {
                        // Aplicar manifiestos en orden específico
                        sh '''
                            KUBECTL_CMD=$(command -v kubectl || echo "${KUBECTL_PATH}")
                            echo "Aplicando namespace..."
                            ${KUBECTL_CMD} apply -f namespace.yaml
                            
                            echo "Esperando a que el namespace esté listo..."
                            sleep 2
                            
                            echo "Aplicando deployment..."
                            ${KUBECTL_CMD} apply -f deployment.yaml
                            
                            echo "Aplicando service..."
                            ${KUBECTL_CMD} apply -f service.yaml
                            
                            echo "Aplicando HPA..."
                            ${KUBECTL_CMD} apply -f hpa.yaml
                        '''
                    }
                }
            }
        }
        
        stage('Verificar despliegue') {
            steps {
                script {
                    echo 'Verificando estado del despliegue...'
                    sh '''
                        KUBECTL_CMD=$(command -v kubectl || echo "${KUBECTL_PATH}")
                        echo "Verificando pods..."
                        ${KUBECTL_CMD} get pods -n ${NAMESPACE} -w --timeout=120s || true
                        
                        echo ""
                        echo "Estado de los recursos:"
                        ${KUBECTL_CMD} get all -n ${NAMESPACE}
                        
                        echo ""
                        echo "Verificando que el deployment esté listo..."
                        ${KUBECTL_CMD} wait --for=condition=available --timeout=120s deployment/demo-app -n ${NAMESPACE} || true
                        
                        echo ""
                        echo "Estado final del deployment:"
                        ${KUBECTL_CMD} describe deployment demo-app -n ${NAMESPACE}
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo 'Pipeline ejecutado exitosamente'
            script {
                sh '''
                    KUBECTL_CMD=$(command -v kubectl || echo "${KUBECTL_PATH}")
                    echo "=========================================="
                    echo "Despliegue completado exitosamente"
                    echo "=========================================="
                    ${KUBECTL_CMD} get all -n ${NAMESPACE}
                '''
            }
        }
        failure {
            echo 'Pipeline falló'
            script {
                sh '''
                    KUBECTL_CMD=$(command -v kubectl || echo "${KUBECTL_PATH}")
                    echo "=========================================="
                    echo "Despliegue falló. Revisa los logs:"
                    echo "=========================================="
                    ${KUBECTL_CMD} get pods -n ${NAMESPACE}
                    ${KUBECTL_CMD} logs -n ${NAMESPACE} -l app=demo-app --tail=50 || true
                '''
            }
        }
        always {
            deleteDir()
        }
    }
}
